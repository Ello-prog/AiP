<% layout('./layout/page.ejs') %>

<section class="hero">
  <img src="/images/niva.jpg" alt="Lada Niva">
  <div class="hero-copy">
    <p class="eyebrow">Тольятти · с 1966</p>
    <h1>АвтоВАЗ</h1>
    <p class="tagline">Дорога начинается в Тольятти.</p>
    <p class="lead">Модельный ряд Lada: город, трасса, бездорожье и классические седаны ВАЗ-2107 и ВАЗ-2170.</p>
  </div>
</section>

<section class="garage">
  <p class="kicker">Модельный ряд</p>
  <h2>Модели, с которых начинается разговор</h2>
  <div class="grid">
    <% cars.forEach(function (car) { %>
      <a class="card" href="<%= car.href %>">
        <img src="<%= car.picture %>" alt="<%= car.title %>">
        <p class="tag"><%= car.tag %></p>
        <h3><%= car.title %></h3>
        <p><%= car.card %></p>
      </a>
    <% }) %>
  </div>
</section>
