<% layout('./layout/page.ejs') %>

<% if (typeof user !== 'undefined' && user) { %>
   <h1>Привет <%= user.username %></h1>
<% } else { %>
   <h1>Привет незалогиненный пользователь</h1>
<% } %>

<h1><%= title %></h1>
<p>Российский автопроизводитель. Марка автомобилей — Lada. Город: Тольятти.</p>
<p>Счетчик: <%= counter %></p>
